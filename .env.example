# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Postgres connection string for the APP role (app_user, NO BYPASSRLS).
#  - Local Docker:  postgresql://app_user:app_user@localhost:5433/docintake
#  - Neon cloud:    postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#    (On Neon you cannot make a NOBYPASSRLS login role easily; connect as the
#     owner role — FORCE ROW LEVEL SECURITY in schema.sql keeps RLS enforced.)
DATABASE_URL=postgresql://app_user:app_user@localhost:5433/docintake

# Admin/superuser URL used ONLY to create the schema, roles and extensions.
# For local Docker this is the postgres superuser on the same database.
# For Neon, use your owner role connection string here.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/docintake

# Symmetric key for pgp_sym_encrypt of patient name + MRN (PHI at rest).
PHI_ENCRYPTION_KEY=change-me-dev-only-pgp-key

# Secret for HMAC of MRN (deterministic, for equality lookups without decrypting).
MRN_HMAC_KEY=change-me-dev-only-hmac-key
